rules_version = '2';
// Reglas de la base de Nadar por la gloria. Se pegan en Firebase → Firestore → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: solo la cuenta de Google del dueño, con el mail verificado
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'matiasslopez@gmail.com' && request.auth.token.email_verified == true;
    }
    function okAlias(a) { return a is string && a.size() <= 16; }
    function okChar(c) { return c in ['facu', 'luis', 'mati', 'pablo', 'luchito', 'fer', 'gaston', 'mica', 'andre']; }
    function okMode(m) { return m in ['sprint', 'idavuelta', 'abiertas']; }
    // Apodos reservados por los que entraron con Google (names/{apodo en minúsculas} → uid).
    function nameOf(a) { return /databases/$(database)/documents/names/$(a.lower()); }
    // Quién escribe: una cuenta (g_ + su uid, con el apodo reservado a su nombre)
    // o un dispositivo (d + letras y números), que no puede usar un apodo reservado.
    function isAccount(id) { return request.auth != null && id == 'g_' + request.auth.uid; }
    function aliasOk(id, a) {
      return isAccount(id) ? getAfter(nameOf(a)).data.uid == request.auth.uid
        : id.matches('d[0-9a-z]+') && !exists(nameOf(a));
    }

    // Carreras terminadas: todos leen (para las métricas), nadie edita; máx. una cada 8 s por dispositivo
    match /runs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['alias', 'char', 'mode', 'dist', 'place', 'time', 'cup', 'lvl', 'dive', 'turns', 'plat', 'device', 'at'])
        && (!('lvl' in request.resource.data) || (request.resource.data.lvl is int && request.resource.data.lvl >= 0 && request.resource.data.lvl <= 100000))
        && okAlias(request.resource.data.alias) && okChar(request.resource.data.char) && okMode(request.resource.data.mode)
        && request.resource.data.dist is int && request.resource.data.dist >= 50 && request.resource.data.dist <= 400
        && request.resource.data.place is int && request.resource.data.place >= 1 && request.resource.data.place <= 4
        && (request.resource.data.time == null || (request.resource.data.time is number
            && request.resource.data.time >= request.resource.data.dist / 8 && request.resource.data.time <= 1200))
        && request.resource.data.device is string && request.resource.data.device.size() <= 40
        && getAfter(/databases/$(database)/documents/lim/$(request.resource.data.device)).data.t == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Récords del grupo: uno por dispositivo y modo; solo se puede bajar el tiempo
    match /boards/{board}/best/{dev} {
      allow read: if true;
      allow create, update: if board in ['sprint-100', 'idavuelta-200', 'abiertas-150']
        && request.resource.data.keys().hasOnly(['alias', 'char', 'time', 'at'])
        && okAlias(request.resource.data.alias) && request.resource.data.alias.size() > 0 && okChar(request.resource.data.char)
        && aliasOk(dev, request.resource.data.alias)
        && request.resource.data.time is number && request.resource.data.time >= 5 && request.resource.data.time <= 1200
        && (resource == null || request.resource.data.time < resource.data.time);
      allow delete: if isAdmin();
    }
    // El camino: cómo va cada uno (uno por dispositivo, o por cuenta si entró con Google). Todos lo leen para el ranking.
    // El nivel nunca baja. En un dispositivo sube de a poco (como mucho 10 de golpe, por si jugó sin internet);
    // en una cuenta puede saltar más, porque junta lo que jugó en varios celus.
    match /players/{dev} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['alias', 'lvl', 'stars', 'cups', 'char', 'at', 'map', 'v'])
        && okAlias(request.resource.data.alias) && request.resource.data.alias.size() > 0 && okChar(request.resource.data.char)
        && aliasOk(dev, request.resource.data.alias)
        && (!('map' in request.resource.data) || (isAccount(dev) && request.resource.data.map is string && request.resource.data.map.size() <= 3000))
        && (!('v' in request.resource.data) || (isAccount(dev) && request.resource.data.v == true))
        && request.resource.data.lvl is int && request.resource.data.lvl >= 1
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= request.resource.data.lvl * 3
        && request.resource.data.cups is int && request.resource.data.cups >= 0
        && request.resource.data.at is string && request.resource.data.at.size() <= 30
        && (isAccount(dev)
            ? request.resource.data.lvl <= 300 && (resource == null || (request.resource.data.lvl >= resource.data.lvl && request.resource.data.cups >= resource.data.cups))
            : resource == null ? request.resource.data.lvl <= 30 && request.resource.data.cups <= 30
            : request.resource.data.lvl >= resource.data.lvl && request.resource.data.lvl <= resource.data.lvl + 10
              && request.resource.data.cups >= resource.data.cups && request.resource.data.cups <= resource.data.cups + 5);
      allow delete: if isAdmin();
    }
    // Apodos reservados: el que entró con Google reserva el suyo; nadie lo puede cambiar y solo él lo suelta.
    match /names/{key} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid', 'alias'])
        && request.resource.data.uid == request.auth.uid
        && okAlias(request.resource.data.alias) && request.resource.data.alias.size() > 0
        && key == request.resource.data.alias.lower();
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }
    // Visitas: un documento por dispositivo; el contador solo sube de a 1; solo el admin las lee
    match /visits/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares']);
      allow delete: if false;
    }
    // Comentarios: cualquiera deja uno (máx. uno por minuto por dispositivo); solo el admin los lee
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['rating', 'comment', 'alias', 'char', 'mode', 'device', 'at'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && okAlias(request.resource.data.alias)
        && request.resource.data.device is string && request.resource.data.device.size() > 0 && request.resource.data.device.size() <= 40
        && getAfter(/databases/$(database)/documents/limf/$(request.resource.data.device)).data.t == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Límite de frecuencia: una marca de tiempo por dispositivo
    match /lim/{dev} {
      allow create: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(8, 's');
      allow read, delete: if false;
    }
    match /limf/{dev} {
      allow create: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(60, 's');
      allow read, delete: if false;
    }
  }
}
